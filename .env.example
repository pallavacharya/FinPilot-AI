# Copy to .env (backend reads real environment variables; docker compose reads .env automatically)

# Secret used to sign JWT login tokens. Use a long random string outside of local demos.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-before-deploying

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where the browser finds the API (baked into the frontend at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

EMAIL_MODE=
OWNER_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DASHBOARD_URL=

